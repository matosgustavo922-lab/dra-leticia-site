<?php
declare(strict_types=1);

define('TIKTOK_ACCESS_TOKEN', 'SUBSTITUA_AQUI_PELO_TOKEN');
define('TIKTOK_PIXEL_CODE', 'DANGAO3C77U17TEHQIGG');
define('TIKTOK_EVENTS_API_URL', 'https://business-api.tiktok.com/open_api/v1.3/event/track/');

header('Content-Type: application/json');

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(405);
    echo json_encode(['ok' => false, 'error' => 'method_not_allowed']);
    exit;
}

$raw = file_get_contents('php://input');
$input = json_decode($raw, true);

$eventId = isset($input['event_id']) ? trim((string) $input['event_id']) : '';
$eventName = isset($input['event_name']) ? trim((string) $input['event_name']) : '';
$eventUrl = isset($input['event_url']) ? (string) $input['event_url'] : '';
$referrer = isset($input['referrer']) ? (string) $input['referrer'] : '';

if ($eventId === '' || $eventName === '') {
    http_response_code(400);
    echo json_encode(['ok' => false, 'error' => 'missing_required_fields']);
    exit;
}

$payload = [
    'event_source' => 'web',
    'event_source_id' => TIKTOK_PIXEL_CODE,
    'data' => [[
        'event' => $eventName,
        'event_time' => time(),
        'event_id' => $eventId,
        'user' => [
            'ip' => $_SERVER['REMOTE_ADDR'] ?? '',
            'user_agent' => $_SERVER['HTTP_USER_AGENT'] ?? '',
        ],
        'page' => [
            'url' => $eventUrl,
            'referrer' => $referrer,
        ],
    ]],
];

$ch = curl_init(TIKTOK_EVENTS_API_URL);
curl_setopt_array($ch, [
    CURLOPT_POST => true,
    CURLOPT_POSTFIELDS => json_encode($payload),
    CURLOPT_HTTPHEADER => [
        'Content-Type: application/json',
        'Access-Token: ' . TIKTOK_ACCESS_TOKEN,
    ],
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_TIMEOUT => 3,
    CURLOPT_CONNECTTIMEOUT => 3,
]);

$response = curl_exec($ch);
$curlError = curl_error($ch);
$httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
curl_close($ch);

if ($response === false) {
    error_log('[tiktok-event] cURL error: ' . $curlError);
} elseif ($httpCode < 200 || $httpCode >= 300) {
    error_log('[tiktok-event] TikTok API returned HTTP ' . $httpCode . ': ' . $response);
}

http_response_code(200);
echo json_encode(['ok' => true]);
